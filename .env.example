# Copy this file to .env and fill in the values from
# Firebase console > Project settings > Your apps > Web app.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=

# Optional: also email each contact message through Formspree.
VITE_FORMSPREE_ID=

# The public address of the site (used for SEO, sitemap and share cards).
VITE_SITE_URL=https://example.com

# Used for the page titles and descriptions written into the HTML at build
# time (for Google and link previews). The live site updates them from the
# dashboard, but search engines read this version first.
VITE_CANDIDATE_NAME=[Candidate Name]
VITE_COUNTY=[County]
